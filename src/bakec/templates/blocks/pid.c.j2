/**
 * @brief PID controller computation
 *
 * @trace {{ meta.model_path }} → blocks.{{ block.name }}
 *
 * @param setpoint  Desired value
 * @param measured  Measured value
 * @param dt        Sample time [s]
 * @return          Controller output
 */


static real_T {{ block.name }}_compute(real_T setpoint, real_T measured, real_T dt)
{
    real_T error = setpoint - measured;

    /* Proportional */
    real_T p_term = {{ block.params.Kp | c_real }} * error;

    /* Integral with anti-windup */
    {{ block.integral_state }} += error * dt;
{% if block.params.anti_windup | default(false) %}
    if ({{ block.integral_state }} > {{ block.params.output_max | c_real }}) {
        {{ block.integral_state }} = {{ block.params.output_max | c_real }};
    } else if ({{ block.integral_state }} < {{ block.params.output_min | c_real }}) {
        {{ block.integral_state }} = {{ block.params.output_min | c_real }};
    } else {
        /* within limits */
    }
{% endif %}
    real_T i_term = {{ block.params.Ki | c_real }} * {{ block.integral_state }};

    /* Derivative */
    real_T d_term = 0.0{{ type_suffix }};
    if (dt > 0.0{{ type_suffix }}) {
        d_term = {{ block.params.Kd | c_real }} * (error - {{ block.prev_error_state }}) / dt;
    }
    {{ block.prev_error_state }} = error;

    /* Sum and saturate */
    real_T output = p_term + i_term + d_term;

{% if block.params.output_max is defined %}
    if (output > {{ block.params.output_max | c_real }}) {
        output = {{ block.params.output_max | c_real }};
    } else if (output < {{ block.params.output_min | c_real }}) {
        output = {{ block.params.output_min | c_real }};
    } else {
        /* within limits */
    }
{% endif %}

    return output;
}
